# Google Gemini API Keys (Dung cho Cloud Mode hoac de nhan dien cau hoi Vector)
GEMINI_API_KEY=your_gemini_api_key_1
GEMINI_API_KEY2=your_gemini_api_key_2
GEMINI_API_KEY3=your_gemini_api_key_3

# LLM Provider Configuration
# Chon: 'gemini' (chay bang Cloud API cua Google) hoac 'local' (chay offline qua Ollama tren GPU RTX 5060)
LLM_PROVIDER=gemini

# Cau hinh cho che do Local LLM (khi LLM_PROVIDER=local)
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_URL=http://localhost:11434
