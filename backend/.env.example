# =====================================================================
# CAU HINH BACKEND CHATBOT AI UTEE (DO AN 1 - UTT)
# Copy file nay thanh .env va dien thong tin thuc te (KHONG commit .env)
# =====================================================================

# 1. CO SO DU LIEU QUAN HE (PostgreSQL hoac SQLite cho moi truong Dev nhanh)
# Chay PostgreSQL qua Docker: docker compose up -d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/utee_db
# Neu chua bat Docker PostgreSQL, co the tam dung SQLite local:
# DATABASE_URL=sqlite:///./utee_local.db

# 2. BAO MAT & XAC THUC JWT
JWT_SECRET_KEY=utee_doan1_super_secret_jwt_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 3. GOOGLE AI STUDIO - GEMINI API KEYS (Ho tro xoay vong nhieu key chong Rate Limit 429)
GEMINI_API_KEY=your_google_ai_studio_api_key_1
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# Cau hinh Model Gemini mac dinh (co the chinh dong trong app/chatbot_config.json)
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 4. CAU HINH CORS FRONTEND (Cac port Vite 8080/5173 va Next.js/React 3000)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://localhost:3000
